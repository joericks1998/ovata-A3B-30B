# Ovata executor grammar — v0.1
#
# Constrains model output to valid tool calls or a terminal result string.
# Used with llama.cpp --grammar-file at inference time.
#
# Jade's runtime injects tool-specific argument schemas in place of the
# generic `object` rule to get full per-tool enforcement.
#
# Two valid assistant turn shapes:
#   1. tool-turn   — one or more tool calls (primary case)
#   2. result-turn — a plain string terminal value (rare)

root ::= tool-turn | result-turn

# ── Tool turn ────────────────────────────────────────────────────────────────

tool-turn ::= tool-call+

# Each call: <|tool_call|> JSON <|tool_call|> newline
tool-call ::= "<|tool_call|>" tool-call-body "<|tool_call|>" "\n"

tool-call-body ::= "{" ws name-field "," ws arguments-field ws "}"

name-field      ::= "\"name\""      ws ":" ws string
arguments-field ::= "\"arguments\"" ws ":" ws object

# ── Terminal result ───────────────────────────────────────────────────────────

result-turn ::= string

# ── JSON primitives ───────────────────────────────────────────────────────────

object  ::= "{" ws (member ("," ws member)*)? ws "}"
member  ::= string ws ":" ws value
array   ::= "[" ws (value  ("," ws value )*)? ws "]"
value   ::= object | array | string | number | boolean | null
string  ::= "\"" ([^"\\] | "\\" .)* "\""
number  ::= "-"? ([0-9] | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
boolean ::= "true" | "false"
null    ::= "null"
ws      ::= [ \t\n]*
